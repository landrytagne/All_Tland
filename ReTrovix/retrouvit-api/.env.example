# ═══════════════════════════════════════════════════════════════
# RetrouvIt Backend — Environment Variables
# Copy this file to application-local.yml or set in production
# ═══════════════════════════════════════════════════════════════

# ─── Database ──────────────────────────────────────────────────
# PostgreSQL connection.
# Local dev via docker compose : le port hôte est 5435 (5432 occupé par
# d'autres projets sur cette machine) — voir docker-compose.yml.
# Dans le réseau Docker, l'API utilise jdbc:postgresql://postgres:5432/retrouvit_db
DATABASE_URL=jdbc:postgresql://localhost:5435/retrouvit_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# ─── JWT ───────────────────────────────────────────────────────
# Generate a secure secret: openssl rand -base64 64
JWT_SECRET=ZXlKcGRXazZhV3hzWDJzMFpXVnpZMkYwYVc5dVgybHpYMjFwZEY5aGJXVT0K
JWT_EXPIRATION=3600000            # 1 hour (access token)
JWT_REFRESH_EXPIRATION=2592000000 # 30 days (refresh token)

# ─── Server ────────────────────────────────────────────────────
SERVER_PORT=8080

# ─── Email (SMTP) ─────────────────────────────────────────────
# Dev: MailHog du docker compose — port hôte 2025 (1025 occupé)
# UI MailHog : http://localhost:4025
# Prod: use real SMTP
MAIL_HOST=localhost
MAIL_PORT=2025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_STARTTLS=false

# ─── File Upload ───────────────────────────────────────────────
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE=10485760  # 10MB

# ─── Frontend URL (for email links) ───────────────────────────
# Web du docker compose : port hôte 3005 (3000 occupé)
APP_URL=http://localhost:3005
APP_NAME=RetrouvIt

# ─── Sentry Error Tracking (optional) ─────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
