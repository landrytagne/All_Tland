# ═══════════════════════════════════════════════════════════════
# RetrouvIt Backend — Environment Variables
# Copy this file to application-local.yml or set in production
# ═══════════════════════════════════════════════════════════════

# ─── Database ──────────────────────────────────────────────────
# PostgreSQL connection
DATABASE_URL=jdbc:postgresql://localhost:5432/retrouvit_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# ─── JWT ───────────────────────────────────────────────────────
# Generate a secure secret: openssl rand -base64 64
JWT_SECRET=ZXlKcGRXazZhV3hzWDJzMFpXVnpZMkYwYVc5dVgybHpYMjFwZEY5aGJXVT0K
JWT_EXPIRATION=3600000            # 1 hour (access token)
JWT_REFRESH_EXPIRATION=2592000000 # 30 days (refresh token)

# ─── Server ────────────────────────────────────────────────────
SERVER_PORT=8080

# ─── Email (SMTP) ─────────────────────────────────────────────
# Dev: use MailHog/MailTrap  |  Prod: use real SMTP
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_STARTTLS=false

# ─── File Upload ───────────────────────────────────────────────
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE=10485760  # 10MB

# ─── Frontend URL (for email links) ───────────────────────────
APP_URL=http://localhost:3000
APP_NAME=RetrouvIt

# ─── Sentry Error Tracking (optional) ─────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
